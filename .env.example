# ── Local LLM (development / plumbing) ──────────────────────────────────────
# Use Ollama for building & testing graph architecture. No API costs.
# Pull commands: ollama pull qwen3.5:9b && ollama pull nomic-embed-text
OLLAMA_MODEL=qwen3.5:9b
# Context window for the local model. Ollama's default of 2048 truncates research
# context badly. 8192 was the July fix for that; it was measured on 2026-08-03 to
# return an EMPTY report for a 12-passage prompt, because num_ctx must also hold
# the reasoning trace. 16384 produces a correct 553-word report on the same input
# at ~1.8x latency and 84% GPU offload. qwen3.5:9b itself supports 262144.
# When a prompt exceeds this, Ollama truncates from the FRONT — dropping the
# system prompt, i.e. the grounding rules — so this is an accuracy setting.
OLLAMA_NUM_CTX=16384
OLLAMA_EMBED_MODEL=nomic-embed-text   # used by eval/ for answer_relevancy embeddings

# ── Cloud LLM (production / prompt tuning) ───────────────────────────────────
# Groq free tier: openai/gpt-oss-120b, 1K req/day, no credit card.
# (llama-3.3-70b-versatile is deprecated on free tiers — shutdown 2026-08-16.)
# Get key at: console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── LangSmith observability (free tier: 100K traces/month) ───────────────────
# Get key at: smith.langchain.com — set TRACING_V2=true once you have a key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=athena

# ── MCP server (streamable HTTP) ─────────────────────────────────────────────
# false = in-process web_search tool (default, cloud-safe)
# true  = connect to FastMCP web server (run: python -m mcp_servers.web_server)
MCP_MODE=false
MCP_WEB_URL=http://localhost:8001/mcp

# ── LLM backend selection ─────────────────────────────────────────────────────
# auto (default) = Groq if GROQ_API_KEY is set, else Ollama.
# groq | ollama force a backend. The UI's model picker sets this at runtime.
ATHENA_LLM_BACKEND=auto

# Local reasoning trace. Turning it OFF is ~4x faster per case (208s -> 48s) but
# measurably less accurate: on the grounding eval it produced 5 fabricated
# figures across 2 cases and 2 misattributed answers, versus 0 and 0 with it on.
# Leave it ON for anything you will demo, publish, or evaluate. Set false only
# for plumbing and UI work where answer accuracy does not matter.
ATHENA_OLLAMA_REASONING=true

# ── Document mode (M5) ────────────────────────────────────────────────────────
# web (default)  = research the internet with the ddgs/MCP search tool
# documents      = research ONLY the local corpus. No web tool is loaded at all,
#                  which is what makes "no data leaves this machine" literal.
ATHENA_MODE=web

# Folder of source documents (PDF, XLSX, DOCX, CSV, MD, TXT) and the index built
# from it. Build/refresh with:  python ingest.py
ATHENA_CORPUS_DIR=corpus
ATHENA_INDEX_PATH=athena_index.db

# Retrieval embedding model, served by Ollama.  ollama pull bge-m3
# bge-m3 is multilingual: the corpus is German and English and questions cross
# languages. nomic-embed-text is English-centric — measured here, a German and
# English sentence with identical meaning scored only 0.540 cosine (vs 0.305 for
# unrelated text), which is too weak a margin to retrieve across languages.
ATHENA_EMBED_MODEL=bge-m3

# Retrieval shape. k is passages per search; the char budget bounds what a single
# tool result may add to the model's context.
ATHENA_SEARCH_K=6
ATHENA_SEARCH_CHAR_BUDGET=6000

# Hard cap on rows indexed per spreadsheet/CSV sheet. Hitting it is always
# announced as a visible notice, never silent partial indexing.
ATHENA_MAX_ROWS_EMBEDDED=2000

# ── Service layer ─────────────────────────────────────────────────────────────
# Checkpointer: memory (tests/CI) | sqlite (durable — paused reviews survive restarts)
ATHENA_CHECKPOINTER=sqlite
ATHENA_DB_PATH=athena.db
# Set to require "Authorization: Bearer <token>" on all /research endpoints.
# Empty = auth disabled (local development only).
ATHENA_API_TOKEN=
ATHENA_WORKERS=4
